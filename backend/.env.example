# Backend Configuration
# This file is mainly for local/dev backend runs. Production docker deploys should use the
# repository root `.env`, which includes TURN/SFU/gateway and compose-facing settings.

# Port to run the server on
BACKEND_PORT=3000
PORT=3000

# Frontend URL for CORS (for development only)
# In production, the backend will auto-detect the frontend origin
FRONTEND_URL=http://localhost:5173

# Public URL for self-hosted deployments or custom domains
# Set this when deploying to a custom domain or self-hosted IP
# Examples:
#   PUBLIC_URL=http://192.168.1.100:3000
#   PUBLIC_URL=https://your-domain.com
#   PUBLIC_URL=https://wabi.onrender.com
# Leave blank to auto-detect from same-origin deployments
PUBLIC_URL=

# TURN REST credentials (backend-minted ephemeral TURN auth)
# Must match coturn static-auth-secret and realm.
TURN_EXTERNAL_IP=127.0.0.1
TURN_REALM=localhost
TURN_SHARED_SECRET=replace_with_long_random_shared_secret
TURN_CREDENTIAL_TTL_SECONDS=3600

# Optional packaged server-side booster relay mode.
# off               : origin only
# turn-only         : self-hosted TURN relay on the same machine
# turn-sfu          : TURN + self-hosted SFU on the same machine
# turn-sfu-gateway  : TURN + SFU + SRT gateway on the same machine
# If you want origin-minted TURN credentials to work across booster nodes,
# all TURN-capable booster relays must share the same TURN_SHARED_SECRET and TURN_REALM contract.
BOOSTER_RELAY_MODE=off
BOOSTER_RELAY_PUBLIC_URL=
BOOSTER_RELAY_NAME=
BOOSTER_RELAY_REGION=
BOOSTER_RELAY_BANDWIDTH_MBPS=
BOOSTER_RELAY_STORAGE_GB=
BOOSTER_RELAY_HEARTBEAT_SECONDS=60

# Optional LiveKit SFU runtime for local/dev or single-box testing.
# If you later use SFU-capable booster relays, the origin and those nodes must share the same
# LIVEKIT_API_KEY / LIVEKIT_API_SECRET contract because the origin mints the access tokens.
SFU_PROVIDER=none
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional media gateway / local SRT control-plane flags.
MEDIA_SRT_GATEWAY_ENABLED=false
MEDIA_SRT_GATEWAY_URL=
MEDIA_GATEWAY_KEY=

# Logging (optional)
ENABLE_LOGGING=false

# Client-side video compression metrics (safe default OFF)
# When false, backend ignores /api/telemetry/video-compression submissions.
WABI_VIDEO_COMPRESSION_CLIENT_METRICS_ENABLED=false

# Plugin trust policy
# warn-allow  : allow unsigned plugins, verify signatures when present
# signed-only : require signatures and trusted signer (or first-party plugin)
# curated-only: only allow first-party plugins
PLUGIN_SIGNATURE_POLICY=warn-allow

# Payment access bootstrap
# off             : leave DB-stored payment policy alone
# seed_if_missing : write the policy once if no payment policy exists yet
# force           : overwrite the DB-stored payment policy on every boot
# Thailand payment plugin (PromptPay QR + optional PSP adapter)
TH_PAYMENTS_PROMPTPAY_PROXY_ID=
TH_PAYMENTS_WEBHOOK_SECRET=
TH_PAYMENTS_ADAPTER_BASE_URL=
TH_PAYMENTS_ADAPTER_TOKEN=
TH_PAYMENTS_ADAPTER_SIGNING_SECRET=
TH_PAYMENTS_ADAPTER_TIMEOUT_MS=10000

# Bitcoin payment plugin (Bitcoin QR + optional Lightning adapter/test mode)
BTC_PAYMENTS_DONATION_ADDRESS=
BTC_PAYMENTS_LABEL=Wabi
BTC_PAYMENTS_WEBHOOK_SECRET=
BTC_PAYMENTS_ADAPTER_BASE_URL=
BTC_PAYMENTS_ADAPTER_TOKEN=
BTC_PAYMENTS_ADAPTER_SIGNING_SECRET=
BTC_PAYMENTS_ADAPTER_TIMEOUT_MS=10000
BTC_PAYMENTS_TEST_MODE=false

# Western payment plugin (PSP adapter or local test mode)
WEST_PAYMENTS_WEBHOOK_SECRET=
WEST_PAYMENTS_ADAPTER_BASE_URL=
WEST_PAYMENTS_ADAPTER_TOKEN=
WEST_PAYMENTS_ADAPTER_SIGNING_SECRET=
WEST_PAYMENTS_ADAPTER_TIMEOUT_MS=10000
WEST_PAYMENTS_TEST_MODE=false

PAYMENTS_ACCESS_BOOTSTRAP_MODE=off
PAYMENTS_ACCESS_ENABLED=false
PAYMENTS_ACCESS_ALLOW_GUEST=false
PAYMENTS_ACCESS_ALLOWED_ROLES=owner,admin,mod,member
