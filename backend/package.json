{
  "name": "wabi-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/server.js --external:socket.io --external:better-sqlite3 --external:jsonwebtoken --external:jws --external:safe-buffer --external:buffer --external:bcrypt --external:adm-zip",
    "migrate:sqlite-to-postgres": "node scripts/migrate-sqlite-to-postgres.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.6.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "esbuild": "^0.27.2",
    "tsx": "^4.21.0"
  }
}
