// src/db/database.ts
import Database from "better-sqlite3";
import { fileURLToPath as fileURLToPath2 } from "url";
import { dirname as dirname2, join } from "path";
import fs2 from "fs";
var __filename = fileURLToPath2(import.meta.url);
var __dirname3 = dirname2(__filename);
var DB_DIR = process.env.DATABASE_PATH ? dirname2(process.env.DATABASE_PATH) : join(process.cwd(), "data");
var DB_FILE = process.env.DATABASE_PATH || join(DB_DIR, "chat.db");
if (!fs2.existsSync(DB_DIR)) {
  fs2.mkdirSync(DB_DIR, { recursive: true });
}
console.log(`[Database] Initializing SQLite at: ${DB_FILE}`);
var db = new Database(DB_FILE);
db.pragma("foreign_keys = ON");
function initializeDatabase() {
  const schemaPath = join(__dirname3, "schema.sql");
  const schema = fs2.readFileSync(schemaPath, "utf-8");
  const statements = schema.split(";").filter((stmt) => stmt.trim().length > 0);
  for (const statement of statements) {
    try {
      db.exec(statement);
    } catch (error) {
      if (!(error instanceof Error && error.message.includes("already exists"))) {
        console.error(`[Database] Error executing statement:`, error);
      }
    }
  }
  console.log("[Database] \u2705 Schema initialized");
}
function closeDatabase() {
  db.close();
  console.log("[Database] \u2705 Connection closed");
}
var database_default = db;

// src/db/repositories/sessionRepository.ts
var SessionRepository = class {
  // Create a new session
  create(session) {
    const stmt = database_default.prepare(`
			INSERT INTO sessions (session_id, user_id, username, color, profile_picture, created_at, expires_at, is_temporary, socket_id, last_seen)
			VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
		`);
    stmt.run(
      session.session_id,
      session.user_id || null,
      session.username,
      session.color,
      session.profile_picture || null,
      session.created_at,
      session.expires_at || null,
      session.is_temporary,
      session.socket_id || null,
      session.last_seen || null
    );
  }
  // Find session by ID
  findById(sessionId) {
    const stmt = database_default.prepare("SELECT * FROM sessions WHERE session_id = ?");
    return stmt.get(sessionId) || null;
  }
  // Find session by user ID
  findByUserId(userId) {
    const stmt = database_default.prepare("SELECT * FROM sessions WHERE user_id = ? ORDER BY created_at DESC LIMIT 1");
    return stmt.get(userId) || null;
  }
  // Update session
  update(sessionId, updates) {
    const allowedFields = ["user_id", "socket_id", "last_seen", "username", "color", "profile_picture"];
    const fields = Object.keys(updates).filter((key) => allowedFields.includes(key));
    if (fields.length === 0) return;
    const setClause = fields.map((field) => `${field} = ?`).join(", ");
    const values = fields.map((field) => updates[field]);
    const stmt = database_default.prepare(`UPDATE sessions SET ${setClause} WHERE session_id = ?`);
    stmt.run(...values, sessionId);
  }
  // Delete session
  delete(sessionId) {
    const stmt = database_default.prepare("DELETE FROM sessions WHERE session_id = ?");
    stmt.run(sessionId);
  }
  // Clean up expired sessions
  cleanup() {
    const stmt = database_default.prepare("DELETE FROM sessions WHERE expires_at IS NOT NULL AND expires_at < ?");
    const info = stmt.run(Date.now());
    return info.changes;
  }
  // Get all active sessions
  getAll() {
    const stmt = database_default.prepare("SELECT * FROM sessions");
    return stmt.all();
  }
};
var sessionRepository = new SessionRepository();

// src/db/repositories/offlineMessageRepository.ts
var OfflineMessageRepository = class {
  // Queue an offline message
  queue(message) {
    const stmt = database_default.prepare(`
			INSERT INTO offline_messages (from_user_id, from_username, to_user_id, channel_id, message_content, message_type, gif_url, file_url, file_name, file_size, created_at, expires_at, delivered)
			VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 0)
		`);
    const info = stmt.run(
      message.from_user_id || null,
      message.from_username,
      message.to_user_id,
      message.channel_id,
      message.message_content,
      message.message_type,
      message.gif_url || null,
      message.file_url || null,
      message.file_name || null,
      message.file_size || null,
      message.created_at,
      message.expires_at
    );
    return {
      message_id: info.lastInsertRowid,
      ...message,
      delivered: 0
    };
  }
  // Get undelivered messages for a user
  getByRecipient(toUserId) {
    const stmt = database_default.prepare(`
			SELECT * FROM offline_messages
			WHERE to_user_id = ? AND delivered = 0
			ORDER BY created_at ASC
		`);
    return stmt.all(toUserId);
  }
  // Mark messages as delivered
  markDelivered(messageIds) {
    if (messageIds.length === 0) return;
    const placeholders = messageIds.map(() => "?").join(",");
    const stmt = database_default.prepare(`UPDATE offline_messages SET delivered = 1 WHERE message_id IN (${placeholders})`);
    stmt.run(...messageIds);
  }
  // Delete expired messages
  deleteExpired() {
    const stmt = database_default.prepare("DELETE FROM offline_messages WHERE expires_at < ?");
    const info = stmt.run(Date.now());
    return info.changes;
  }
  // Get message count for a user
  getCountByRecipient(toUserId) {
    const stmt = database_default.prepare("SELECT COUNT(*) as count FROM offline_messages WHERE to_user_id = ? AND delivered = 0");
    const result = stmt.get(toUserId);
    return result.count;
  }
};
var offlineMessageRepository = new OfflineMessageRepository();

// src/auth/jwt.ts
var import_jsonwebtoken = __toESM(require_jsonwebtoken(), 1);
var JWT_SECRET = process.env.JWT_SECRET || "dev-secret-change-in-production";
var JWT_EXPIRES_IN = "30d";
function generateToken(payload) {
  return import_jsonwebtoken.default.sign(payload, JWT_SECRET, { expiresIn: JWT_EXPIRES_IN });
}
function verifyToken(token) {
  try {
    return import_jsonwebtoken.default.verify(token, JWT_SECRET);
  } catch (error) {
    throw new Error("Invalid or expired token");
  }
}

// src/db/repositories/userRepository.ts
var UserRepository = class {
  // Create a new user
  create(user) {
    const stmt = database_default.prepare(`
			INSERT INTO users (username, password_hash, created_at, color, profile_picture, bio)
			VALUES (?, ?, ?, ?, ?, ?)
		`);
    const info = stmt.run(
      user.username,
      user.password_hash,
      user.created_at,
      user.color,
      user.profile_picture || null,
      user.bio || null
    );
    return {
      user_id: info.lastInsertRowid,
      ...user
    };
  }
  // Find user by username
  findByUsername(username) {
    const stmt = database_default.prepare("SELECT * FROM users WHERE username = ? COLLATE NOCASE");
    return stmt.get(username) || null;
  }
  // Find user by ID
  findById(userId) {
    const stmt = database_default.prepare("SELECT * FROM users WHERE user_id = ?");
    return stmt.get(userId) || null;
  }
  // Update user profile
  update(userId, updates) {
    const allowedFields = ["color", "profile_picture", "bio", "is_active"];
    const fields = Object.keys(updates).filter((key) => allowedFields.includes(key));
    if (fields.length === 0) return;
    const setClause = fields.map((field) => `${field} = ?`).join(", ");
    const values = fields.map((field) => updates[field]);
    const stmt = database_default.prepare(`UPDATE users SET ${setClause} WHERE user_id = ?`);
    stmt.run(...values, userId);
  }
  // Delete user
  delete(userId) {
    const stmt = database_default.prepare("DELETE FROM users WHERE user_id = ?");
    stmt.run(userId);
  }
  // Get all users
  getAll() {
    const stmt = database_default.prepare("SELECT * FROM users WHERE is_active = 1");
    return stmt.all();
  }
};
var userRepository = new UserRepository();

// src/db/repositories/settingsRepository.ts
var SettingsRepository = class {
  // Get settings for a user (create defaults if not exists)
  get(userId) {
    let settings = this.findById(userId);
    if (!settings) {
      this.set(userId, {
        offline_message_retention: "7d",
        allow_temp_user_messages: 1
      });
      settings = this.findById(userId);
    }
    return settings;
  }
  // Find settings by user ID
  findById(userId) {
    const stmt = database_default.prepare("SELECT * FROM user_settings WHERE user_id = ?");
    return stmt.get(userId) || null;
  }
  // Set settings for a user
  set(userId, settings) {
    const existing = this.findById(userId);
    if (!existing) {
      const stmt = database_default.prepare(`
				INSERT INTO user_settings (user_id, offline_message_retention, allow_temp_user_messages)
				VALUES (?, ?, ?)
			`);
      stmt.run(
        userId,
        settings.offline_message_retention || "7d",
        settings.allow_temp_user_messages !== void 0 ? settings.allow_temp_user_messages : 1
      );
    } else {
      const fields = Object.keys(settings).filter((key) => key !== "user_id");
      if (fields.length === 0) return;
      const setClause = fields.map((field) => `${field} = ?`).join(", ");
      const values = fields.map((field) => settings[field]);
      const stmt = database_default.prepare(`UPDATE user_settings SET ${setClause} WHERE user_id = ?`);
      stmt.run(...values, userId);
    }
  }
  // Get message retention period in milliseconds
  getRetentionMs(userId) {
    const settings = this.get(userId);
    const retention = settings.offline_message_retention;
    const map = {
      "1d": 1 * 24 * 60 * 60 * 1e3,
      "7d": 7 * 24 * 60 * 60 * 1e3,
      "30d": 30 * 24 * 60 * 60 * 1e3,
      "forever": Number.MAX_SAFE_INTEGER
    };
    return map[retention] || map["7d"];
  }
  // Check if user allows temp user messages
  allowsTempMessages(userId) {
    const settings = this.get(userId);
    return settings.allow_temp_user_messages === 1;
  }
};
var settingsRepository = new SettingsRepository();

// src/auth/passwordHash.ts
var import_bcrypt = __toESM(require_bcrypt(), 1);
var SALT_ROUNDS = 10;
async function hashPassword(password) {
  return await import_bcrypt.default.hash(password, SALT_ROUNDS);
}
async function verifyPassword(password, hash) {
  return await import_bcrypt.default.compare(password, hash);
}

// src/api/authRoutes.ts
var rateLimitMap = /* @__PURE__ */ new Map();
function checkRateLimit(key, maxAttempts, windowMs) {
  const now = Date.now();
  const entry = rateLimitMap.get(key);
  if (!entry || now > entry.resetTime) {
    rateLimitMap.set(key, { count: 1, resetTime: now + windowMs });
    return true;
  }
  if (entry.count >= maxAttempts) {
    return false;
  }
  entry.count++;
  return true;
}
function validateInput(username, password) {
  if (!username || username.trim().length < 2) {
    return { valid: false, error: "Username must be at least 2 characters" };
  }
  if (!password || password.length < 8) {
    return { valid: false, error: "Password must be at least 8 characters" };
  }
  if (username.length > 32) {
    return { valid: false, error: "Username must be less than 32 characters" };
  }
  return { valid: true };
}
function parseBody(req) {
  return new Promise((resolve, reject) => {
    let body = "";
    req.on("data", (chunk) => {
      body += chunk.toString();
    });
    req.on("end", () => {
      try {
        resolve(JSON.parse(body));
      } catch (error) {
        reject(new Error("Invalid JSON"));
      }
    });
    req.on("error", reject);
  });
}
function generateColor() {
  const colors = [
    "#FF6B6B",
    // Red
    "#4ECDC4",
    // Teal
    "#45B7D1",
    // Blue
    "#FFA07A",
    // Orange
    "#98D8C8",
    // Mint
    "#F7DC6F",
    // Yellow
    "#BB8FCE",
    // Purple
    "#85C1E2"
    // Light Blue
  ];
  return colors[Math.floor(Math.random() * colors.length)];
}
async function handleRegister(req, res) {
  try {
    const clientIp = req.socket.remoteAddress || "unknown";
    const rateLimitKey = `register:${clientIp}`;
    if (!checkRateLimit(rateLimitKey, 5, 15 * 60 * 1e3)) {
      res.writeHead(429, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ error: "Too many registration attempts. Try again later." }));
      return;
    }
    const body = await parseBody(req);
    const { username, password } = body;
    const validation = validateInput(username, password);
    if (!validation.valid) {
      res.writeHead(400, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ error: validation.error }));
      return;
    }
    if (userRepository.findByUsername(username)) {
      res.writeHead(409, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ error: "Username already taken" }));
      return;
    }
    const passwordHash = await hashPassword(password);
    const user = userRepository.create({
      username,
      password_hash: passwordHash,
      created_at: Date.now(),
      color: generateColor()
    });
    settingsRepository.set(user.user_id, {
      offline_message_retention: "7d",
      allow_temp_user_messages: 1
    });
    const sessionId = `reg-${Date.now()}-${Math.random().toString(36).slice(2)}`;
    sessionRepository.create({
      session_id: sessionId,
      user_id: user.user_id,
      username: user.username,
      color: user.color,
      created_at: Date.now(),
      expires_at: Date.now() + 30 * 24 * 60 * 60 * 1e3,
      // 30 days
      is_temporary: 0
    });
    const token = generateToken({
      sessionId,
      userId: user.user_id,
      isTemporary: false
    });
    res.writeHead(201, { "Content-Type": "application/json" });
    res.end(
      JSON.stringify({
        token,
        user: {
          id: user.user_id,
          username: user.username,
          color: user.color,
          isRegistered: true
        }
      })
    );
  } catch (error) {
    console.error("[Auth] Register error:", error);
    res.writeHead(500, { "Content-Type": "application/json" });
    res.end(JSON.stringify({ error: "Registration failed" }));
  }
}
async function handleLogin(req, res) {
  try {
    const clientIp = req.socket.remoteAddress || "unknown";
    const rateLimitKey = `login:${clientIp}`;
    if (!checkRateLimit(rateLimitKey, 10, 5 * 60 * 1e3)) {
      res.writeHead(429, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ error: "Too many login attempts. Try again later." }));
      return;
    }
    const body = await parseBody(req);
    const { username, password } = body;
    if (!username || !password) {
      res.writeHead(400, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ error: "Username and password required" }));
      return;
    }
    const user = userRepository.findByUsername(username);
    if (!user) {
      res.writeHead(401, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ error: "Invalid credentials" }));
      return;
    }
    const isValid = await verifyPassword(password, user.password_hash);
    if (!isValid) {
      res.writeHead(401, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ error: "Invalid credentials" }));
      return;
    }
    const sessionId = `reg-${Date.now()}-${Math.random().toString(36).slice(2)}`;
    sessionRepository.create({
      session_id: sessionId,
      user_id: user.user_id,
      username: user.username,
      color: user.color,
      profile_picture: user.profile_picture,
      created_at: Date.now(),
      expires_at: Date.now() + 30 * 24 * 60 * 60 * 1e3,
      // 30 days
      is_temporary: 0
    });
    const token = generateToken({
      sessionId,
      userId: user.user_id,
      isTemporary: false
    });
    res.writeHead(200, { "Content-Type": "application/json" });
    res.end(
      JSON.stringify({
        token,
        user: {
          id: user.user_id,
          username: user.username,
          color: user.color,
          profilePicture: user.profile_picture,
          isRegistered: true
        }
      })
    );
  } catch (error) {
    console.error("[Auth] Login error:", error);
    res.writeHead(500, { "Content-Type": "application/json" });
    res.end(JSON.stringify({ error: "Login failed" }));
  }
}
async function handleUpgrade(req, res) {
  try {
    const body = await parseBody(req);
    const { sessionId, password } = body;
    if (!sessionId || !password) {
      res.writeHead(400, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ error: "Session ID and password required" }));
      return;
    }
    const validation = validateInput("temp", password);
    if (!validation.valid) {
      res.writeHead(400, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ error: validation.error }));
      return;
    }
    const tempSession = sessionRepository.findById(sessionId);
    if (!tempSession || !tempSession.is_temporary) {
      res.writeHead(404, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ error: "Session not found" }));
      return;
    }
    if (userRepository.findByUsername(tempSession.username)) {
      res.writeHead(409, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ error: "Username already taken" }));
      return;
    }
    const passwordHash = await hashPassword(password);
    const user = userRepository.create({
      username: tempSession.username,
      password_hash: passwordHash,
      created_at: tempSession.created_at,
      color: tempSession.color,
      profile_picture: tempSession.profile_picture
    });
    settingsRepository.set(user.user_id, {
      offline_message_retention: "7d",
      allow_temp_user_messages: 1
    });
    const newSessionId = `reg-${Date.now()}-${Math.random().toString(36).slice(2)}`;
    sessionRepository.delete(sessionId);
    sessionRepository.create({
      session_id: newSessionId,
      user_id: user.user_id,
      username: user.username,
      color: user.color,
      profile_picture: user.profile_picture,
      created_at: Date.now(),
      expires_at: Date.now() + 30 * 24 * 60 * 60 * 1e3,
      is_temporary: 0
    });
    const token = generateToken({
      sessionId: newSessionId,
      userId: user.user_id,
      isTemporary: false
    });
    res.writeHead(200, { "Content-Type": "application/json" });
    res.end(
      JSON.stringify({
        token,
        user: {
          id: user.user_id,
          username: user.username,
          color: user.color,
          profilePicture: user.profile_picture,
          isRegistered: true
        }
      })
    );
  } catch (error) {
    console.error("[Auth] Upgrade error:", error);
    res.writeHead(500, { "Content-Type": "application/json" });
    res.end(JSON.stringify({ error: "Upgrade failed" }));
  }
}
async function handleGetUserSettings(req, res) {
  try {
    const authHeader = req.headers.authorization;
    if (!authHeader || !authHeader.startsWith("Bearer ")) {
      res.writeHead(401, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ error: "Missing or invalid authorization" }));
      return;
    }
    const userId = req.userId;
    if (!userId) {
      res.writeHead(401, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ error: "User not authenticated" }));
      return;
    }
    const settings = settingsRepository.get(userId);
    res.writeHead(200, { "Content-Type": "application/json" });
    res.end(JSON.stringify({
      offline_message_retention: settings.offline_message_retention,
      allow_temp_user_messages: settings.allow_temp_user_messages === 1
    }));
  } catch (error) {
    console.error("[Auth] Get settings error:", error);
    res.writeHead(500, { "Content-Type": "application/json" });
    res.end(JSON.stringify({ error: "Failed to load settings" }));
  }
}
async function handleSaveUserSettings(req, res) {
  try {
    const authHeader = req.headers.authorization;
    if (!authHeader || !authHeader.startsWith("Bearer ")) {
      res.writeHead(401, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ error: "Missing or invalid authorization" }));
      return;
    }
    const userId = req.userId;
    if (!userId) {
      res.writeHead(401, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ error: "User not authenticated" }));
      return;
    }
    const body = await parseBody(req);
    const { offline_message_retention, allow_temp_user_messages } = body;
    const validRetentions = ["1d", "7d", "30d", "forever"];
    if (offline_message_retention && !validRetentions.includes(offline_message_retention)) {
      res.writeHead(400, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ error: "Invalid retention period" }));
      return;
    }
    settingsRepository.set(userId, {
      offline_message_retention: offline_message_retention || "7d",
      allow_temp_user_messages: allow_temp_user_messages ? 1 : 0
    });
    res.writeHead(200, { "Content-Type": "application/json" });
    res.end(JSON.stringify({ success: true }));
  } catch (error) {
    console.error("[Auth] Save settings error:", error);
    res.writeHead(500, { "Content-Type": "application/json" });
    res.end(JSON.stringify({ error: "Failed to save settings" }));
  }
}

