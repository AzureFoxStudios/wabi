function emitToChannel(channelId, event, data) {
  const channel = channels.get(channelId);
  if (!channel) return;
  if (channel.members && channel.members.length > 0) {
    channel.members.forEach((memberId) => {
      io.to(memberId).emit(event, data);
    });
  } else {
    io.emit(event, data);
  }
}
deleteMessageById = (channelId, messageId) => {
  const messages = channelMessages.get(channelId) || [];
  const messageIndex = messages.findIndex((m) => m.id === messageId);
  if (messageIndex === -1) return;
  const message = messages[messageIndex];
  if (message.fileUrl) {
    const fileName = message.fileUrl.replace("/uploads/", "");
    const filePath = join2(UPLOADS_DIR, fileName);
    try {
      if (existsSync(filePath)) {
        unlinkSync(filePath);
      }
    } catch (err) {
      console.error(`Failed to delete file: ${fileName}`, err);
    }
  }
  if (message.files && message.files.length > 0) {
    for (const file of message.files) {
      const fileName = file.fileUrl.replace("/uploads/", "");
      const filePath = join2(UPLOADS_DIR, fileName);
      try {
        if (existsSync(filePath)) {
          unlinkSync(filePath);
        }
      } catch (err) {
        console.error(`Failed to delete file: ${fileName}`, err);
      }
    }
  }
  messages.splice(messageIndex, 1);
  channelMessages.set(channelId, messages);
  const timer = messageDeletionTimers.get(messageId);
  if (timer) {
    clearTimeout(timer);
    messageDeletionTimers.delete(messageId);
  }
  emitToChannel(channelId, "message-deleted", { channelId, messageId });
  if (ENABLE_LOGGING) {
    console.log(`\u{1F5D1}\uFE0F Auto-deleted message ${messageId} from channel ${channelId}`);
  }
};
