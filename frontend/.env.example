# Frontend Configuration

# Socket.IO Server URL
# Leave blank for automatic detection (recommended for most deployments)
#
# Auto-detection rules:
# - In local development (localhost:5173): Connects to http://localhost:3000
# - In production with same-origin backend: Uses window.location.origin
# - Works with Render, self-hosted, and any other deployment
#
# Only set this if you need to explicitly override auto-detection:
# Examples:
#   VITE_SOCKET_URL=http://192.168.1.100:3000
#   VITE_SOCKET_URL=https://your-domain.com
#   VITE_SOCKET_URL=https://wabi.onrender.com
VITE_SOCKET_URL=

# Giphy API Key (for GIF picker feature)
# Get a free API key from: https://developers.giphy.com/dashboard
# Leave blank to disable GIF picker
VITE_GIPHY_API_KEY=

# ==============================================================================
# TURN Server Configuration (for Voice/Video Calling)
# ==============================================================================
# These settings must match your TURN server configuration

# TURN server address (domain or IP, without protocol)
# For local testing: 127.0.0.1
# For production: your.domain.com
VITE_TURN_SERVER=127.0.0.1

# TURN server port
# Standard TURN (no TLS): 3478
# TURNS (with TLS): 5349
VITE_TURN_PORT=3478

# TURN authentication credentials (must match server configuration)
# IMPORTANT: Change these to match your TURN server credentials
VITE_TURN_USERNAME=wabi
VITE_TURN_PASSWORD=change_this_password

# Use TURNS (TLS) instead of TURN
# Set to true if you have SSL certificates configured on your TURN server
VITE_USE_TURNS=false

# Optional: Google STUN Fallback
# Enable Google STUN servers as fallback (can be disabled for full independence)
VITE_ENABLE_GOOGLE_STUN=true
