# ==============================================================================
# Wabi Chat Frontend Configuration (frontend/.env)
# ==============================================================================
# Copy this file to frontend/.env and update values for your deployment

# ==============================================================================
# Socket.IO Server Configuration
# ==============================================================================
# Socket.IO server URL for WebSocket connection
# Leave EMPTY to auto-detect from window.location.origin
# Useful for:
#   - Local dev: http://localhost:3000
#   - Explicit override: https://wabi.chat
# If empty, frontend will:
#   1. Use VITE_SOCKET_URL env var at build time (if set)
#   2. Auto-detect from browser location
VITE_SOCKET_URL=

# ==============================================================================
# Third-Party API Keys
# ==============================================================================
# Giphy API key for GIF search
VITE_GIPHY_API_KEY=432vWeSYvBNbv4z5YL7MYgcg8zMT5L91

# ==============================================================================
# WebRTC TURN Server Configuration (for voice/video calls)
# ==============================================================================
# TURN server IP or hostname
VITE_TURN_SERVER=188.166.209.20

# TURN server port
VITE_TURN_PORT=3478

# Use TURNS (TURN over TLS) for encrypted TURN signaling
VITE_USE_TURNS=false

# Enable Google STUN server as fallback for ICE candidate gathering
VITE_ENABLE_GOOGLE_STUN=true

# Optional compatibility fallback only (not recommended for production):
# VITE_TURN_USERNAME=
# VITE_TURN_PASSWORD=

# ==============================================================================
# Relay Network Configuration
# ==============================================================================
# Enable relay-based file downloads (requires relay infrastructure)
# This is intentionally separate from core server setup/launch scripts.
VITE_ENABLE_RELAYS=false

# Client-side video compression metrics (safe default OFF)
# When false, no video-compression metrics requests are sent.
VITE_VIDEO_COMPRESSION_CLIENT_METRICS=false
