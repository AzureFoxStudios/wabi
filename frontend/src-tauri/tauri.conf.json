{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wabi",
  "version": "0.2.0",
  "identifier": "com.wabi.app",
  "build": {
    "beforeBuildCommand": "bun run build",
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Wabi",
        "width": 1400,
        "height": 900,
        "minWidth": 600,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://wabi.chat wss://wabi.chat https://*.giphy.com; img-src 'self' https: data: blob:; media-src 'self' blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
