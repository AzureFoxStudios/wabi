/* ===== MESSAGE DENSITY MODES ===== */

/* Hide compact-only continuation headers in default/cozy mode. */
.compact-only-header {
	display: none;
}


/* Cozy: airy mockup-aligned spacing — 8px vertical padding, 14px gap, 40px avatars. */
.message {
	gap: 1rem;
	margin: 0;
	padding: 0.57rem 0.64rem;
	border-radius: 0;
	overflow: visible;
}

:global(html[data-message-density='cozy']) .message {
	gap: 0.6rem !important;
	margin: 0 !important;
	padding: 0.35rem 0.5rem !important;
	border-radius: 0 !important;
}


.message:hover {
	background: rgba(var(--surface-base-rgb), 0.28);
}

:global(html[data-message-density='cozy']) .message:hover {
	background: rgba(var(--surface-base-rgb), 0.28) !important;
}


.message + .message:not(.continuation) {
	margin-top: 0.42rem;
}

:global(html[data-message-density='cozy']) .message + .message:not(.continuation) {
	margin-top: 0.28rem !important;
}


.message.has-continuation {
	padding-bottom: 0;
}

:global(html[data-message-density='cozy']) .message.has-continuation {
	padding-bottom: 0 !important;
}


.message.continuation {
	margin-top: 0;
	padding-top: 0.214rem;
	padding-bottom: 0.214rem;
}

:global(html[data-message-density='cozy']) .message.continuation {
	margin-top: 0 !important;
	padding-top: 0.12rem !important;
	padding-bottom: 0.12rem !important;
}


.message.continuation .message-avatar-spacer {
	height: 0;
	margin-top: 0;
}

:global(html[data-message-density='cozy']) .message.continuation .message-avatar-spacer {
	height: 0 !important;
	margin-top: 0 !important;
}


.message.continuation .message-body {
	margin-top: 0;
}

:global(html[data-message-density='cozy']) .message.continuation .message-body {
	margin-top: 0 !important;
}


.message .message-header {
	margin-bottom: 0.05rem;
	line-height: 1.18;
}

:global(html[data-message-density='cozy']) .message .message-header {
	margin-bottom: 0.05rem !important;
	line-height: 1.28 !important;
}


.avatar,
.avatar-placeholder {
	width: 32px;
	height: 32px;
}

:global(html[data-message-density='cozy']) .avatar,
:global(html[data-message-density='cozy']) .avatar-placeholder {
	width: 32px !important;
	height: 32px !important;
}


.message-avatar-spacer {
	width: 32px;
}

:global(html[data-message-density='cozy']) .message-avatar-spacer {
	width: 32px !important;
}


/* Compact: IRC-style rows. Avatars are hidden and every row gets an inline identity header. */
:global(html[data-message-density='compact']) .message,
:global(html[data-message-density='compact']) .message.continuation,
:global(html[data-message-density='compact']) .message.has-continuation {
	gap: 0 !important;
	margin: 0 !important;
	padding: 0.04rem 0.58rem !important;
}


:global(html[data-message-density='compact']) .message + .message:not(.continuation) {
	margin-top: 0.22rem !important;
}


:global(html[data-message-density='compact']) .message-avatar,
:global(html[data-message-density='compact']) .message-avatar-spacer {
	display: none !important;
	width: 0 !important;
	height: 0 !important;
	margin: 0 !important;
}


:global(html[data-message-density='compact']) .message-body {
	display: flex !important;
	align-items: baseline !important;
	gap: 0.32rem !important;
	width: 100% !important;
	max-width: 100% !important;
	margin: 0 !important;
	padding: 0 !important;
}


:global(html[data-message-density='compact']) .message-header,
:global(html[data-message-density='compact']) .compact-only-header {
	display: flex !important;
	flex: 0 1 auto !important;
	min-width: 0 !important;
	margin: 0 !important;
	white-space: nowrap !important;
	line-height: 1.2 !important;
