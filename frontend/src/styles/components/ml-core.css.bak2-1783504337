/* --- Load More Pagination Styles --- */

.load-more-container {
	display: flex;
	justify-content: center;
	align-items: center;
	padding: 1rem;
	gap: 1rem;
}


.load-more-btn {
	display: flex;
	align-items: center;
	gap: 0.5rem;
	padding: 0.5rem 1rem;
	background-color: var(--accent-primary-color);
	color: var(--text-on-accent);
	border: none;
	border-radius: var(--radius-md);
	cursor: pointer;
	font-size: var(--text-base);
	font-weight: 500;
	transition: background-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
}


.load-more-btn:hover:not(:disabled) {
	background-color: color-mix(in srgb, var(--accent-primary-color) 88%, transparent);
	transform: translateY(-1px);
}


.load-more-btn:focus-visible {
	outline: 2px solid color-mix(in srgb, var(--accent-primary-color) 70%, transparent);
	outline-offset: 2px;
}


.load-more-btn:disabled {
	opacity: 0.6;
	cursor: not-allowed;
	transform: none;
}


.load-more-btn .spinner {
	display: inline-block;
	width: 14px;
	height: 14px;
	border: 2px solid rgba(var(--text-primary-rgb), var(--opacity-light));
	border-top-color: var(--text-heading);
	border-radius: 50%;
	animation: spin 0.6s linear infinite;
}


.no-more-messages {
	text-align: center;
	color: var(--text-secondary);
	font-size: var(--text-base);
	padding: 1rem;
}


/* TEMPORARY: Embedded media styles */
.embedded-media {
	max-width: 100%;
