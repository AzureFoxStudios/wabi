{
  "name": "wabi-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:mock": "VITE_WABI_LOCAL_MOCK=1 vite dev --host 127.0.0.1 --port 5173",
    "build": "if [ -z \"$STATIC_BUILD\" ]; then echo '' && echo '⚠️  STATIC_BUILD is unset. Default frontend build uses adapter-node (no index.html).' && echo '    For production / Docker / deploy, use: npm run build:static' && echo '    The static build (adapter-static) emits index.html for rust_embed.' && echo '' && echo '    Building with adapter-node anyway (for dev/SSR use). Set STATIC_BUILD=1 to silence.' && echo ''; fi && vite build",
    "build:static": "STATIC_BUILD=1 vite build",
    "build:only": "vite build",
    "build:tauri": "node scripts/build-tauri.mjs",
    "preview": "vite preview",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test src/lib",
    "check:zip-preview": "bun run scripts/zip-preview-fixture-smoke.ts",
    "check:unicode-emojis": "bun run scripts/unicode-emoji-compat-smoke.ts",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "tauri-dev": "tauri dev",
    "tauri-build": "tauri build",
    "tauri-android-init": "tauri android init",
    "tauri-android-dev": "tauri android dev",
    "tauri-android-build": "tauri android build",
    "tauri-ios-init": "tauri ios init",
    "tauri-ios-dev": "tauri ios dev",
    "tauri-ios-build": "tauri ios build"
  },
  "devDependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/state": "6.7.1",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.8",
    "@sveltejs/adapter-node": "5.5.4",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.59.0",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/bun": "1.3.14",
    "@types/qrcode": "1.5.6",
    "playwright": "1.62.1",
    "svelte": "5.56.8",
    "svelte-check": "4.4.7",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vite": "8.2.0"
  },
  "dependencies": {
    "@giphy/js-fetch-api": "5.8.0",
    "@tauri-apps/api": "2.11.1",
    "@xyflow/svelte": "1.6.3",
    "dompurify": "3.4.12",
    "katex": "0.18.4",
    "livekit-client": "2.21.0",
    "marked": "18.0.9",
    "motion": "13.1.1",
    "opus-recorder": "8.0.5",
    "prismjs": "1.30.0",
    "qrcode": "1.5.4",
    "socket.io-client": "4.8.3",
    "svelte-i18n": "4.0.1"
  },
  "overrides": {
    "socket.io-parser": "4.2.6",
    "devalue": "5.9.0",
    "ws": "8.21.1",
    "uuid": "11.1.1",
    "@codemirror/view": "6.43.8"
  }
}
