:8088 {
    # This Caddy instance runs behind a Cloudflare tunnel.
    # TLS termination happens at the tunnel edge, so Caddy
    # only listens on HTTP here. Security headers are still
    # applied for defense-in-depth.

    # ------------------------------------------------------------------
    # Security headers
    # ------------------------------------------------------------------
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Voice/calling needs WebRTC + LiveKit: STUN/TURN ICE servers, the
        # dynamic SFU websocket (any wss host), media blob streams, and workers.
        # cf. docs/CALLING_CSP_DEBUG_2026-07-15.md
        # Camera/mic/geolocation and frame/script/img-src below cover calling,
        # OpenStreetMap embeds, and media embeds (audit finding 3).
        # img-src uses broad https: for media previews (e.g. Giphy) because
        # preview URLs come from multiple hosts; script/frame are pinned to
        # the specific vendors used by the shipped integrations.
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://www.youtube.com https://www.youtube-nocookie.com https://esm.sh; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' wss: stun: turn: https:; media-src 'self' blob: data: mediastream:; worker-src 'self' blob:; font-src 'self' data:; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://open.spotify.com https://www.openstreetmap.org; object-src 'none'; frame-ancestors 'none'"
        # Feature permissions — allow self for calling (camera/mic) and maps (geolocation)
        Permissions-Policy "camera=(self), microphone=(self), geolocation=(self)"
    }

    # ------------------------------------------------------------------
    # Request body size limit for uploads (50 GB max)
    # ------------------------------------------------------------------
    request_body /api/upload* {
        max_size 53687091200
    }

    # ------------------------------------------------------------------
    # Forward headers for upstream server
    # ------------------------------------------------------------------
    reverse_proxy wabi-server:3000 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {host}
        header_up X-Forwarded-For {http.request.remote.host}
    }
}
