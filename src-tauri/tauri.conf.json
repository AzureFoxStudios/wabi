{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Wabi",
  "version": "0.1.0",
  "identifier": "chat.wabi.app",
  "build": {
    "frontendDist": "../frontend/build",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd frontend && bun run build",
    "beforeDevCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Wabi",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["openssl", "libssl3"]
      },
      "rpm": {
        "depends": ["openssl", "libssl3"]
      },
      "appimage": {}
    }
  },
  "plugins": {
    "notification": {
      "active": true
    },
    "shell": {
      "active": true
    }
  }
}
