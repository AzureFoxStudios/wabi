{
  "id": "webhooks",
  "name": "Webhooks",
  "version": "0.1.0",
  "description": "Webhook service for Wabi - triggers webhooks on events",
  "backend": {
    "runtime": "rust",
    "path": "backend",
    "crate": "wabi-webhooks",
    "cargo_feature": "wabi-webhooks"
  },
  "frontend": {
    "contributions": {
      "channelTypes": [],
      "workspacePanels": [],
      "settingsPages": [],
      "mobileTabs": []
    },
    "bundled": false
  },
  "permissions": [
    "network:outbound"
  ]
}
