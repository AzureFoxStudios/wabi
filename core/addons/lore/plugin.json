{
  "id": "lore",
  "name": "Lore",
  "version": "0.1.0",
  "description": "Version-controlled binary asset storage via Epic Games Lore - for CAD files, 3D models, and large binaries",
  "backend": {
    "runtime": "rust",
    "path": "backend",
    "crate": "wabi-lore",
    "cargo_feature": "wabi-lore"
  },
  "frontend": {
    "contributions": {
      "channelTypes": [],
      "workspacePanels": [],
      "settingsPages": [],
      "mobileTabs": []
    },
    "bundled": false
  },
  "permissions": [
    "network:outbound",
    "filesystem:read",
    "filesystem:write"
  ]
}
