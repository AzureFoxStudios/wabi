# Operator-friendly config for scripts/launch.sh
# Copy to wabi.config and edit this file only.
# Then run: ./scripts/launch.sh
# launch.sh will sync supported keys into .env/frontend/.env automatically.
#
# PROFILE:
#   starter   -> normal mode (SQLite)
#   community -> community mode (SQLite + STDB-ready)
PROFILE=starter

# RUNTIME:
#   node (default, recommended)
#   bun  (advanced)
RUNTIME=node

# Public host users will open (domain preferred for HTTPS).
# Use localhost only for local testing.
DOMAIN=localhost

# CALLS:
#   off              -> no self-hosted coturn profile
#   self_hosted_turn -> deploy coturn profile locally
#   external_turn    -> skip coturn profile (external TURN provider)
CALLS=off

# Advanced media flags (off by default).
# Relay network setup is intentionally separated from core server setup.
# For relay deployment, use relay-node/README.md and PROJECT_DOCS/RELAY_PHASE1_SERVER_RUNBOOK.md.
ENABLE_MEDIA_GATEWAY=false
# SFU plugin provider:
#   none    -> disable SFU module (default)
#   livekit -> enable LiveKit SFU module
SFU_PROVIDER=none
# Legacy compatibility toggle: ENABLE_SFU=true maps to SFU_PROVIDER=livekit.
ENABLE_SFU=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Plugin system safety defaults.
PLUGINS_ENABLED=false
PLUGINS_ALLOW_INSTALL=false

# State backend controls.
# Use `legacy` (default), `dual_write` for parity rollout, or `stdb_primary` for STDB source-of-truth.
# Modes: legacy | dual_write | stdb_primary
STATE_BACKEND_MODE=legacy
STATE_STDB_READ_ENABLED=false
# State-plane read canary (0-100). Used only when STATE_STDB_READ_ENABLED=true.
# Used as default for all entity read canaries unless overridden below.
STATE_STDB_MESSAGE_READ_CANARY_PERCENT=10
STATE_STDB_CHANNEL_READ_CANARY_PERCENT=10
STATE_STDB_CHANNEL_MEMBER_READ_CANARY_PERCENT=10
STATE_STDB_USER_READ_CANARY_PERCENT=10
STATE_STDB_SESSION_READ_CANARY_PERCENT=10
STATE_STDB_RBAC_READ_CANARY_PERCENT=10
STATE_SHADOW_WARMUP_ENABLED=true
STATE_SHADOW_WARMUP_LIMIT=25000
STATE_STDB_WRITE_ENABLED=false
STATE_STDB_SUBSCRIPTIONS_ENABLED=false
STATE_STDB_ENFORCE_RBAC=true
STATE_BACKEND_STRICT=false
# Optional outbox file override (default inside DATA_DIR).
STATE_OUTBOX_PATH=
STATE_OUTBOX_REDACT_SENSITIVE=true
STATE_OUTBOX_MAX_BYTES=67108864
STATE_OUTBOX_TRUNCATE_MIN_BYTES=16777216
# Shadow writer controls (used in dual_write migration).
# STATE_SHADOW_WRITER_ENABLED auto-enables when dual_write + STATE_STDB_WRITE_ENABLED=true.
STATE_SHADOW_WRITER_ENABLED=false
# mirror -> local applied log file, http -> POST to STATE_SHADOW_ENDPOINT,
# command -> execute STATE_SHADOW_COMMAND and pipe one JSON event to stdin per call.
STATE_SHADOW_SINK=mirror
STATE_SHADOW_ENDPOINT=
STATE_SHADOW_TOKEN=
STATE_SHADOW_SIGNING_SECRET=
STATE_SHADOW_SIGNING_KEY_ID=
STATE_SHADOW_COMMAND=
# Example:
# STATE_SHADOW_COMMAND=node scripts/state-plane-stdb-bridge.mjs --mode spacetime-call --server local --database your_db --reducer ingest_wabi_event --no-config --anonymous --yes
STATE_SHADOW_COMMAND_TIMEOUT_MS=10000
# Optional command-bridge helper keys. If STATE_SHADOW_SINK=command and STATE_SHADOW_COMMAND is empty,
# launch.sh auto-generates STATE_SHADOW_COMMAND from these values when database is set.
WABI_STDB_BRIDGE_MODE=spacetime-call
WABI_STDB_BRIDGE_SERVER=local
WABI_STDB_BRIDGE_DATABASE=
WABI_STDB_BRIDGE_REDUCER=ingest_wabi_event
WABI_STDB_BRIDGE_MAP_FILE=
WABI_STDB_BRIDGE_TIMEOUT_MS=10000
# Optional STDB HTTP auth controls for stdb_primary reads/writes.
WABI_STDB_AUTH_TOKEN=
WABI_STDB_ANONYMOUS=false
WABI_STDB_ALLOW_ANONYMOUS_IN_PRODUCTION=false
STATE_PLANE_SCHEMA_VERSION=1
STATE_PLANE_SCHEMA_AUTO_APPLY=true
STATE_REDUCER_INGRESS_ENABLED=false
STATE_REDUCER_INGRESS_REQUIRE_SIGNATURE=true
STATE_REDUCER_INGRESS_MAX_SKEW_MS=300000
STATE_REDUCER_INGRESS_MAX_BODY_BYTES=1048576
STATE_SHADOW_POLL_INTERVAL_MS=1000
STATE_SHADOW_BATCH_SIZE=250

# Webhook delivery hardening
WEBHOOK_MAX_BODY_BYTES=65536
WEBHOOK_ALLOW_PRIVATE_TARGETS=false
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_MAX_DNS_RECORDS=16
WEBHOOK_MAX_CONCURRENT_DELIVERIES=20
WEBHOOK_MAX_EVENT_FANOUT=250

# Privacy/observability controls (safe default OFF).
# Enables backend + frontend video-compression metrics path when true.
VIDEO_COMPRESSION_METRICS=false

# Optional.
GIPHY_API_KEY=
