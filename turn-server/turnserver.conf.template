# Coturn configuration file for Claude Sandbox Relay
#
# A basic configuration for running a secure TURN server.
# For more advanced options, see the full documentation:
# https://github.com/coturn/coturn/blob/master/examples/etc/turnserver.conf

# ---------------------------------------------------------------------------
#  NETWORKING
# ---------------------------------------------------------------------------

# The most important setting: The public IP address of this server.
# For local testing, you can use 127.0.0.1.
# For production, you MUST change this to your server's public IP.
external-ip=${TURN_EXTERNAL_IP}

# Listen on all interfaces
listening-ip=0.0.0.0

# Relay IP - same as external IP for single-server deployments
relay-ip=${TURN_EXTERNAL_IP}

# The port coturn listens on for client connections.
# 3478 is the standard for TURN/STUN.
listening-port=3478

# The range of UDP ports that coturn will use for relaying media.
# This range should be open in your server's firewall.
min-port=49160
max-port=49200

# ---------------------------------------------------------------------------
#  AUTHENTICATION & SECURITY
# ---------------------------------------------------------------------------

# Use TURN REST API shared-secret mode.
# Backend mints short-lived credentials signed with this secret.
use-auth-secret
static-auth-secret=${TURN_SHARED_SECRET}

# The "realm" distinguishes this TURN server from others.
# It can be a domain name you own or any descriptive name.
realm=${TURN_REALM}

# ---------------------------------------------------------------------------
#  PRODUCTION SECURITY
# ---------------------------------------------------------------------------

# Enable fingerprint for STUN message integrity
fingerprint

# Disable telnet CLI (security - no remote admin)
no-cli

# Prevent relay to localhost (security - avoid SSRF attacks)
denied-peer-ip=127.0.0.1
denied-peer-ip=::1

# ---------------------------------------------------------------------------
#  TLS/TURNS SUPPORT (Optional - for production with SSL)
# ---------------------------------------------------------------------------

# TLS/TURNS SUPPORT
cert=/etc/coturn/certs/cert.pem
pkey=/etc/coturn/certs/privkey.pem
tls-listening-port=5349

# ---------------------------------------------------------------------------
#  LOGGING
# ---------------------------------------------------------------------------

# Disable verbose logging to keep logs clean.
# You can enable it by removing the '#' for debugging.
# verbose

# Log to stdout, which is the standard for Docker containers.
log-file=stdout

# Do not create a PID file. Coturn 4.8.0 treats this as an invalid directive.
# pidfile=
