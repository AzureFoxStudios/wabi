# TURN Server Configuration
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to git!

# TURN REST shared secret (must match backend TURN_SHARED_SECRET)
TURN_SHARED_SECRET=replace_with_long_random_shared_secret

# TURN server public IP (change from 127.0.0.1 for production)
TURN_EXTERNAL_IP=127.0.0.1

# TURN server realm
TURN_REALM=your-domain.com
