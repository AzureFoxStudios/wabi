# Required
RELAY_ORIGIN_URL=https://chat.example.com
RELAY_PUBLIC_URL=https://relay-us-west.example.net
RELAY_NAME=US West Volunteer Relay
RELAY_REGION=us-west

# Optional metadata reported to origin
RELAY_LATITUDE=
RELAY_LONGITUDE=
RELAY_BANDWIDTH_MBPS=
RELAY_STORAGE_GB=
RELAY_SYNCTHING_DEVICE_ID=

# Runtime
RELAY_HOST=0.0.0.0
RELAY_PORT=8090
RELAY_STARTUP_DELAY_MS=3000
RELAY_HEARTBEAT_INTERVAL_MS=60000
RELAY_CACHE_TTL_SECONDS=3600
RELAY_MAX_CACHE_BYTES=52428800
RELAY_CACHE_PATH_PREFIXES=/uploads/,/emotes/

# Local directories
RELAY_CACHE_DIR=./cache
RELAY_STATE_DIR=./state
