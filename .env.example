# ==============================================================================
# WABI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and customize the values for your deployment
# Command: cp .env.example .env
#
# IMPORTANT: Never commit the .env file to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# TURN Server Configuration
# ------------------------------------------------------------------------------
# The TURN server enables voice/video calling across restrictive NATs

# Your server's public IP address or domain name (REQUIRED for production)
# For local testing: 127.0.0.1
# For production: your.domain.com or your public IP
TURN_EXTERNAL_IP=127.0.0.1

# The realm identifier for your TURN server (typically your domain)
TURN_REALM=wabi.local

# TURN server authentication credentials
# IMPORTANT: Change these to secure values in production!
# Generate a secure password with: openssl rand -base64 32
TURN_USERNAME=wabi
TURN_PASSWORD=change_this_password

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------

# Port for the backend server
BACKEND_PORT=8080

# Node environment (development, production)
NODE_ENV=production

# JWT secret for authentication (REQUIRED - generate a secure value)
# Generate with: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------

# Port for the frontend server
FRONTEND_PORT=3000

# Backend URL (leave as default for Docker setup)
FRONTEND_URL=http://localhost:8080
