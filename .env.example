# ==============================================================================
# Wabi Chat Backend Configuration (.env)
# ==============================================================================
# Copy this file to .env and update values for your deployment
# For self-hosted bare-metal Linux with Docker Compose + Caddy

# CORS & Frontend Configuration
# =============================
# CRITICAL: These MUST match the domain users access (required for CORS and WebSocket)
# Examples:
#   - Local Docker: http://localhost:8080
#   - Self-hosted behind Caddy/Nginx: https://wabi.chat
FRONTEND_URL=https://your-domain.com
PUBLIC_URL=https://your-domain.com

# CORS Origin Whitelist (optional)
# If not set, FRONTEND_URL and PUBLIC_URL are used automatically
# Comma-separated for multiple origins
# ALLOWED_ORIGINS=https://wabi.chat,https://www.wabi.chat

# ==============================================================================
# TURN Server Configuration (for WebRTC voice/video calling)
# ==============================================================================
TURN_EXTERNAL_IP=your.public.ip.or.hostname
TURN_REALM=your-domain.com
TURN_SHARED_SECRET=replace_with_long_random_shared_secret
TURN_CREDENTIAL_TTL_SECONDS=3600

# ==============================================================================
# Media Runtime (WebRTC tuning + optional gateway control)
# ==============================================================================
# Enable local enhanced presets for Tauri/native clients
MEDIA_LOCAL_ENHANCED_ENABLED=true

# Optional packaged server-side booster relay mode.
# off               : origin only
# turn-only         : self-hosted TURN relay on the same machine
# turn-sfu          : TURN + self-hosted SFU on the same machine
# turn-sfu-gateway  : TURN + SFU + SRT gateway on the same machine
# If you want origin-minted TURN credentials to work across booster nodes,
# all TURN-capable booster relays must share the same TURN_SHARED_SECRET and TURN_REALM contract.
BOOSTER_RELAY_MODE=off
BOOSTER_RELAY_PUBLIC_URL=
BOOSTER_RELAY_NAME=
BOOSTER_RELAY_REGION=
BOOSTER_RELAY_BANDWIDTH_MBPS=
BOOSTER_RELAY_STORAGE_GB=
BOOSTER_RELAY_HEARTBEAT_SECONDS=60

# Optional SRT/media-gateway control-plane flags (transport remains WebRTC in-browser)
MEDIA_SRT_GATEWAY_ENABLED=false
MEDIA_SRT_GATEWAY_URL=
MEDIA_GATEWAY_HEARTBEAT_TIMEOUT_MS=45000
MEDIA_GATEWAY_KEY=
MEDIA_SRT_SESSION_TTL_SECONDS=900
MEDIA_SRT_BASE_PORT=7000
MEDIA_GATEWAY_ORIGIN_URL=http://backend:8080
MEDIA_GATEWAY_REGION=local
MEDIA_GATEWAY_HEARTBEAT_INTERVAL_MS=15000
MEDIA_GATEWAY_SESSION_SYNC_INTERVAL_MS=10000
MEDIA_GATEWAY_WORKER_ENABLED=false
MEDIA_GATEWAY_WORKER_CMD=
# JSON array; template tokens:
# {{sessionId}} {{channelId}} {{kind}} {{publishUrl}} {{playbackUrl}} {{expiresAt}}
MEDIA_GATEWAY_WORKER_ARGS_JSON=
MEDIA_GATEWAY_WORKER_ENV_PASSTHROUGH=
MEDIA_GATEWAY_WORKER_SHUTDOWN_TIMEOUT_MS=8000

# Optional LiveKit SFU runtime (recommended for true server-routed media)
# Use ws://livekit:7880 when the backend talks to the bundled docker service,
# or a public wss:// URL when clients connect to an externally reachable LiveKit node.
# If you use booster relays for SFU placement, all SFU-capable nodes must share the same
# LIVEKIT_API_KEY / LIVEKIT_API_SECRET contract as the origin token mint path.
SFU_PROVIDER=none
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ==============================================================================
# Backend Server Configuration
# ==============================================================================
PORT=8080
NODE_ENV=production
JWT_SECRET=replace_with_long_random_jwt_secret

# Deployment mode/runtime selection (used by scripts/setup.sh + scripts/deploy-clean.sh)
# WABI_MODE: normal|community
# WABI_RUNTIME: node|bun
# DB_MODE: sqlite
WABI_MODE=normal
WABI_RUNTIME=node
DB_MODE=sqlite

# State backend migration controls
# legacy: current SQL-backed state path
# dual_write: legacy primary + shadow write hooks for migration
# stdb_primary: SpacetimeDB primary read/write path (requires STATE_STDB_READ_ENABLED=true and STATE_STDB_WRITE_ENABLED=true)
STATE_BACKEND_MODE=legacy
STATE_STDB_READ_ENABLED=false
# State-plane read canary percent (0-100), applied when STATE_STDB_READ_ENABLED=true
# Used as default for all entity read canaries unless overridden below.
STATE_STDB_MESSAGE_READ_CANARY_PERCENT=10
STATE_STDB_CHANNEL_READ_CANARY_PERCENT=10
STATE_STDB_CHANNEL_MEMBER_READ_CANARY_PERCENT=10
STATE_STDB_USER_READ_CANARY_PERCENT=10
STATE_STDB_SESSION_READ_CANARY_PERCENT=10
STATE_STDB_RBAC_READ_CANARY_PERCENT=10
STATE_SHADOW_WARMUP_ENABLED=true
STATE_SHADOW_WARMUP_LIMIT=25000
STATE_STDB_WRITE_ENABLED=false
STATE_STDB_SUBSCRIPTIONS_ENABLED=false
STATE_STDB_ENFORCE_RBAC=true
STATE_BACKEND_STRICT=false
STATE_OUTBOX_PATH=
STATE_OUTBOX_REDACT_SENSITIVE=true
STATE_OUTBOX_MAX_BYTES=67108864
STATE_OUTBOX_TRUNCATE_MIN_BYTES=16777216
STATE_SHADOW_WRITER_ENABLED=false
# mirror writes applied events to local file, http posts to STATE_SHADOW_ENDPOINT,
# command pipes newline-delimited event JSON to STATE_SHADOW_COMMAND via stdin
STATE_SHADOW_SINK=mirror
STATE_SHADOW_ENDPOINT=
STATE_SHADOW_TOKEN=
STATE_SHADOW_SIGNING_SECRET=
STATE_SHADOW_SIGNING_KEY_ID=
STATE_SHADOW_COMMAND=
# Example:
# STATE_SHADOW_COMMAND=node scripts/state-plane-stdb-bridge.mjs --mode spacetime-call --server local --database your_db --reducer ingest_wabi_event --no-config --anonymous --yes
STATE_SHADOW_COMMAND_TIMEOUT_MS=10000
WABI_STDB_BRIDGE_MODE=spacetime-call
WABI_STDB_BRIDGE_SERVER=local
WABI_STDB_BRIDGE_DATABASE=
WABI_STDB_BRIDGE_REDUCER=ingest_wabi_event
WABI_STDB_BRIDGE_MAP_FILE=
WABI_STDB_BRIDGE_TIMEOUT_MS=10000
WABI_STDB_AUTH_TOKEN=
WABI_STDB_ANONYMOUS=false
WABI_STDB_ALLOW_ANONYMOUS_IN_PRODUCTION=false
WABI_BACKEND_UPSTREAMS=
WABI_SERVER_INSTANCE_ID=
WABI_MESH_INSTANCE_URL_TEMPLATE=http://{instanceId}:8080
WABI_MESH_INGRESS_URL=
WABI_MESH_SHARED_TOKEN=
STATE_PLANE_SCHEMA_VERSION=1
STATE_PLANE_SCHEMA_AUTO_APPLY=true
STATE_REDUCER_INGRESS_ENABLED=false
STATE_REDUCER_INGRESS_REQUIRE_SIGNATURE=true
STATE_REDUCER_INGRESS_MAX_SKEW_MS=300000
STATE_REDUCER_INGRESS_MAX_BODY_BYTES=1048576
STATE_SHADOW_POLL_INTERVAL_MS=1000
STATE_SHADOW_BATCH_SIZE=250

# Webhook delivery hardening
WEBHOOK_MAX_BODY_BYTES=65536
WEBHOOK_ALLOW_PRIVATE_TARGETS=false
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_MAX_DNS_RECORDS=16
WEBHOOK_MAX_CONCURRENT_DELIVERIES=20
WEBHOOK_MAX_EVENT_FANOUT=250

# Data Directory
DATA_DIR=/app/data

# Plugins Directory
PLUGINS_DIR=/app/plugins

# Plugin runtime controls
# Keep disabled for first-run safety. Enable only when intentionally using plugins.
PLUGINS_ENABLED=false
PLUGINS_ALLOW_INSTALL=false

# Plugin Scanner Gate (FOSS-friendly: off|warn|enforce)
# off: skip scanner
# warn: run scanner and log findings, but allow load
# enforce: block plugin load on scanner errors/findings
PLUGIN_SCAN_POLICY=warn
# Scanner command template. Use {{pluginPath}} and optional {{pluginId}} placeholders.
# Example (ClamAV): clamscan --recursive --infected --no-summary {{pluginPath}}
PLUGIN_SCANNER_CMD=
# Timeout for scanner command execution
PLUGIN_SCANNER_TIMEOUT_MS=120000

# Static Files Directory
STATIC_DIR=/app/frontend/build

# ==============================================================================
# Login Launch Page Customization (optional)
# ==============================================================================
# Communities can provide custom launch-page branding/hero content shown on login.
# Precedence:
#   1) WABI_LAUNCH_PAGE_JSON (inline JSON)
#   2) WABI_LAUNCH_PAGE_PATH (JSON file path; default ./data/launch-page.json)
# Example file is provided at data/launch-page.example.json
WABI_LAUNCH_PAGE_JSON=
WABI_LAUNCH_PAGE_PATH=

# ==============================================================================
# Response & Upload Compression (Phase rollout controls)
# ==============================================================================
# HTTP text response compression for static assets/HTML (Brotli/Gzip negotiation)
HTTP_TEXT_COMPRESSION_ENABLED=true
HTTP_TEXT_COMPRESSION_MIN_BYTES=1024
HTTP_TEXT_COMPRESSION_BROTLI_QUALITY=5
HTTP_TEXT_COMPRESSION_GZIP_LEVEL=6

# Attachment-at-rest compression (safe default OFF until rollout)
UPLOAD_COMPRESSION_ENABLED=false
UPLOAD_COMPRESSION_MIN_BYTES=4096
UPLOAD_COMPRESSION_GZIP_LEVEL=6
UPLOAD_COMPRESSION_ROLLOUT_PERCENT=100
UPLOAD_COMPRESSION_ROLLOUT_SALT=wabi-upload-rollout

# Client-side video compression metrics ingestion (safe default OFF)
# When false, backend ignores /api/telemetry/video-compression submissions.
WABI_VIDEO_COMPRESSION_CLIENT_METRICS_ENABLED=false

# ==============================================================================
# OpenMoji Asset Fetch (build-time)
# ==============================================================================
# Pinned release used by Docker builds and helper scripts
OPENMOJI_VERSION=15.1.0
# Optional: set this to enforce checksum verification
# OPENMOJI_72_SHA256=

# ==============================================================================
# Cloudflare Tunnel (optional, for public access without port forwarding)
# ==============================================================================
# Named tunnel token from Cloudflare Zero Trust dashboard.
# Required only for profile: tunnel-named.
CLOUDFLARE_TUNNEL_TOKEN=

