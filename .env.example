# ===========================================================================
# Wabi Server Configuration
# Copy this file to .env and fill in your values.
# ===========================================================================

# --- Public address --------------------------------------------------------
# URL users will open in their browser. For local dev, use http://localhost:3001
FRONTEND_URL=http://localhost:3001
PUBLIC_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# --- Port mapping ---------------------------------------------------------
# Host port → container port (3000 is the internal port wabi-server binds to)
# Change 3001 to 3000 if you don't want port mapping
WABI_PORT_OUT=3001

# --- Secrets (REQUIRED) ----------------------------------------------------
# Generate: openssl rand -base64 48
# Must be 64+ random chars
WABI_JWT_KEY=REPLACE_ME_openssl_rand_base64_48

# Generate: openssl rand -hex 32
# Must be exactly 64 hex chars (= 32 bytes)
WABIDB_ROOT_KEY=REPLACE_ME_openssl_rand_hex_32

# --- TURN (voice/video calling) -------------------------------------------
# Only needed if you enable the turn profile for voice/video.
# Generate: openssl rand -base64 32
# TURN_HMAC_KEY must be set in .env when using --profile turn.
TURN_HMAC_KEY=REPLACE_ME_openssl_rand_base64_32

# --- Media / calling -------------------------------------------------------
# P2P TURN (coturn profile). Uncomment to enable.
# TURN_EXTERNAL_IP=your.public.ip
# TURN_REALM=your.domain.com

# LiveKit SFU (optional, for group calls)
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# --- Advanced / optional ---------------------------------------------------
# Server instance metadata (multi-node mesh)
# WABI_SERVER_INSTANCE_ID=
# WABI_SERVER_REGION=
# WABI_SERVER_ROLE=authority
# WABI_MESH_INSTANCE_URL_TEMPLATE=
# WABI_MESH_INGRESS_URL=
# WABI_MESH_COORDINATION_KEY=

# Max upload size in bytes (default: 50GB)
WABI_MAX_BODY_SIZE=53687091200

# Admin user IDs (comma-separated)
# WABI_ADMIN_USER_IDS=

# Plugin system (both default to false; not needed for core hosting)
PLUGINS_ENABLED=false
PLUGINS_ALLOW_INSTALL=false

# Cloudflare tunnel token (for tunnel profile)
# CLOUDFLARE_TUNNEL_TOKEN=

# --- OpenMoji (emoji assets) ----------------------------------------------
OPENMOJI_VERSION=15.1.0

# --- Frontend build args (read by docker compose) --------------------------
# VITE_SOCKET_URL=
# VITE_GIPHY_API_KEY=
# VITE_TURN_SERVER=
# VITE_TURN_PORT=3478
# VITE_USE_TURNS=false
# VITE_ENABLE_GOOGLE_STUN=true
