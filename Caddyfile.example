# Wabi Caddyfile — Reverse proxy for Docker Compose deployment
#
# Replace YOUR_DOMAIN with your actual domain (e.g. wabi.example.com).
# Caddy will automatically obtain and renew an SSL certificate via
# Let's Encrypt / ACME — no manual cert management needed.
#
# If you don't have a domain, use ":80" instead of the domain name
# to listen on plain HTTP (no TLS is possible without a domain).
#
# Usage:
#   sudo cp Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Security notes:
# - HSTS is enabled (1 year, includeSubDomains, preload-ready)
# - rate_limit protects against abuse (100 req/min per remote host)
# - security.txt is served for researcher disclosure
# - Request body limited to 50 GB for uploads

YOUR_DOMAIN {
    # ------------------------------------------------------------------
    # Security headers
    # ------------------------------------------------------------------
    header {
        # HTTP Strict Transport Security — force HTTPS for 1 year
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Prevent MIME-type sniffing
        X-Content-Type-Options "nosniff"
        # Prevent clickjacking
        X-Frame-Options "DENY"
        # XSS filter for older browsers
        X-XSS-Protection "1; mode=block"
        # Control referrer leakage
        Referrer-Policy "strict-origin-when-cross-origin"
        # Content Security Policy — adjust if you use external resources
        # Voice/calling needs WebRTC + LiveKit: STUN/TURN ICE servers, the
        # dynamic SFU websocket (any wss host), media blob streams, and workers.
        # Camera/mic/geolocation and frame/script/img-src below cover calling,
        # OpenStreetMap embeds, and media embeds (audit finding 3;
        # cf. docs/CALLING_CSP_DEBUG_2026-07-15.md).
        # img-src uses broad https: for media previews (e.g. Giphy) because
        # preview URLs come from multiple hosts; script/frame are pinned to
        # the specific vendors used by the shipped integrations.
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://www.youtube.com https://www.youtube-nocookie.com https://esm.sh; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' wss: stun: turn: https:; media-src 'self' blob: data: mediastream:; worker-src 'self' blob:; font-src 'self' data:; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://open.spotify.com https://www.openstreetmap.org; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
        # Feature permissions — allow self for calling (camera/mic) and maps (geolocation)
        Permissions-Policy "camera=(self), microphone=(self), geolocation=(self)"
    }

    # ------------------------------------------------------------------
    # Rate limiting (available in Caddy 2.6+)
    # 100 requests per minute per remote host — adjust as needed
    # ------------------------------------------------------------------
    rate_limit {
        zone wabi_api {
            key {http.request.remote.host}
            events 100
            window 1m
        }
    }

    # ------------------------------------------------------------------
    # Request body size limit for uploads (50 GB max)
    # ------------------------------------------------------------------
    request_body /api/upload* {
        max_size 53687091200
    }

    # ------------------------------------------------------------------
    # Security.txt — disclosure endpoint for security researchers
    # https://securitytxt.org/
    # ------------------------------------------------------------------
    respond /.well-known/security.txt `Contact: mailto:security@YOUR_DOMAIN
Preferred-Languages: en
Expires: 2027-07-01T00:00:00.000Z
` 200

    # ------------------------------------------------------------------
    # Robots.txt — allow all crawlers (override if needed)
    # ------------------------------------------------------------------
    respond /robots.txt `User-agent: *
Disallow:
` 200

    # ------------------------------------------------------------------
    # API, WebSocket, uploads, and health checks -> backend container
    # ------------------------------------------------------------------
    @backend {
        path /socket.io/* /api/* /uploads/* /health /health/*
    }
    reverse_proxy @backend localhost:8080 {
        # Forward client IP for logging
        header_up X-Forwarded-For {http.request.remote.host}
    }

    # ------------------------------------------------------------------
    # Everything else -> frontend container
    # ------------------------------------------------------------------
    reverse_proxy localhost:3000 {
        header_up X-Forwarded-For {http.request.remote.host}
    }

    # ------------------------------------------------------------------
    # Access logging (optional — uncomment to enable)
    # ------------------------------------------------------------------
    # log {
    #     output file /var/log/caddy/wabi.access.log
    #     format json
    # }

    # ------------------------------------------------------------------
    # Bot Fight Mode — Caddy does not ship a built-in equivalent of
    # Cloudflare's Bot Fight Mode. For self-hosted bot mitigation:
    #   rate_limit (above) covers basic rate-based abuse.
    #   For advanced protection, consider deploying a WAF in front :
    #   or using Caddy's `replacer` / `header` to drop known bad UAs.
    # ------------------------------------------------------------------
}
