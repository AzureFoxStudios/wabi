{
  "id": "agile-tools",
  "name": "Agile Tools",
  "version": "1.0.0",
  "description": "Sprint planning, task management, and burndown charts for agile teams",
  "author": "Community",
  "enabled": true,
  "backend": {
    "entry": "./backend/index.ts",
    "socketEvents": [
      "task:create",
      "task:update",
      "task:delete",
      "task:list",
      "sprint:create",
      "sprint:start",
      "sprint:end",
      "burndown:get"
    ]
  },
  "frontend": {
    "entry": "./frontend/index.ts",
    "extensions": {
      "sidebar": {
        "icon": "\ud83d\udcca",
        "label": "Agile",
        "component": "./frontend/AgilePanel.svelte",
        "position": 1
      },
      "commands": [
        "/task",
        "/sprint"
      ]
    }
  },
  "permissions": [
    "channels:read",
    "messages:write"
  ],
  "dependencies": [],
  "security": {
    "threatNotes": "Validates task/sprint event payloads on the server side; avoid exposing private workspace data over public channels."
  },
  "integrity": {
    "algorithm": "sha256",
    "checksum": "05f6ed3acbd31d797a9e45b2848d1defd32e2d054298b66d5d916d4b95d7e7bd"
  }
}
