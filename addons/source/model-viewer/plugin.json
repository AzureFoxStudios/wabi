{
  "id": "model-viewer",
  "name": "Model Viewer",
  "version": "0.1.0",
  "description": "Inline 3D model viewing for chat attachments and links.",
  "author": "Community",
  "enabled": true,
  "backend": {
    "entry": "./backend/index.ts"
  },
  "frontend": {
    "entry": "./frontend/index.ts",
    "extensions": {
      "commands": [
        "/model"
      ]
    }
  },
  "permissions": [
    "channels:read"
  ],
  "security": {
    "threatNotes": "Viewer loads remote 3D assets only when explicitly opened in chat; no model editing or file write operations."
  },
  "integrity": {
    "algorithm": "sha256",
    "checksum": "79c0c5e404fb2d1ed9cea7b0dbf1d11c50edd82343e9776befbed49b836c4a6d"
  },
  "capabilities": {
    "tier": "ui-only",
    "notes": "Non-essential rendering helper."
  }
}
